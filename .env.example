# ============================================================
# AGM V3 — Environment Variables
# Copy this file to .env.local and fill in all values
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://agm.church

# ─── OpenRouter (AI) ─────────────────────────────────────────
# Get key at: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-key

# ─── Resend (Email) ──────────────────────────────────────────
# Get key at: https://resend.com
RESEND_API_KEY=re_your-key

# ─── Chariow (Payments) ────────────────────────────────────────
# API key: Chariow dashboard → Developers → API Keys
CHARIOW_API_KEY=sk_live_your-chariow-key
# Signing secret: Chariow dashboard → Automations → Pulses → your endpoint
CHARIOW_PULSE_SECRET=your-pulse-signing-secret

# Chariow product IDs — create one product per amount/tier in your
# Chariow dashboard, then paste each product's ID here.
CHARIOW_PRODUCT_DONATION_10=
CHARIOW_PRODUCT_DONATION_25=
CHARIOW_PRODUCT_DONATION_50=
CHARIOW_PRODUCT_DONATION_100=
CHARIOW_PRODUCT_DONATION_250=
CHARIOW_PRODUCT_DONATION_500=
CHARIOW_PRODUCT_BRONZE_MONTHLY=
CHARIOW_PRODUCT_BRONZE_ANNUAL=
CHARIOW_PRODUCT_SILVER_MONTHLY=
CHARIOW_PRODUCT_SILVER_ANNUAL=
CHARIOW_PRODUCT_GOLD_MONTHLY=
CHARIOW_PRODUCT_GOLD_ANNUAL=

# ─── Feature Flags ───────────────────────────────────────────
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_AFFILIATE=true
